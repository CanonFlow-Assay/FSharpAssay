<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ObligationPluginTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.Compiler.Service" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FSharp.Analyzers.SDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsAssay.Analyzers\FsAssay.Analyzers.fsproj" />
    <ProjectReference Include="..\FsAssay.CanonFlow.Plugin\FsAssay.CanonFlow.Plugin.fsproj" />
    <ProjectReference Include="..\FsAssay.Runner\FsAssay.Runner.fsproj" />
  </ItemGroup>

</Project>
