{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonflow-assay.github.io/FSharpAssay/contracts/fsassay-policy-1.1.0.schema.json",
  "title": "FsAssay authority policy lock 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policySchemaVersion", "evidenceSchemaVersion", "authorityContractVersion", "shapeContractVersion", "toolVersion", "evaluationDate",
    "enabledProfiles", "approvedBlockingRules", "advisoryRules", "experimentalRules", "prototypeRules", "dummyRules", "deprecatedRules", "removedRules",
    "requiredProjectClasses", "requiredTargetFrameworks", "requiredTests", "baseline", "exceptions"
  ],
  "properties": {
    "policySchemaVersion": { "const": "fsassay-policy/1.1.0" },
    "evidenceSchemaVersion": { "const": "fsassay-authority-receipt/1.1.0" },
    "authorityContractVersion": { "const": "authority-contract/1.0.0" },
    "shapeContractVersion": { "const": "fsharp-shape/1.0.0" },
    "toolVersion": { "const": "1.0.4" },
    "evaluationDate": { "$ref": "#/$defs/date" },
    "enabledProfiles": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "approvedBlockingRules": { "$ref": "#/$defs/uniqueStrings", "maxItems": 0 },
    "advisoryRules": { "$ref": "#/$defs/uniqueStrings", "maxItems": 0 },
    "experimentalRules": { "$ref": "#/$defs/uniqueStrings" },
    "prototypeRules": { "$ref": "#/$defs/uniqueStrings" },
    "dummyRules": { "$ref": "#/$defs/uniqueStrings" },
    "deprecatedRules": { "$ref": "#/$defs/uniqueStrings" },
    "removedRules": { "$ref": "#/$defs/uniqueStrings" },
    "requiredProjectClasses": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "requiredTargetFrameworks": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "requiredTests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requiredTest" } },
    "baseline": { "$ref": "#/$defs/baseline" },
    "exceptions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/exception" } }
  },
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sha64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!\\.\\./).+" },
    "uniqueStrings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyUniqueStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "requiredTest": {
      "type": "object", "additionalProperties": false, "required": ["id", "project", "minimumPassed"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "project": { "$ref": "#/$defs/relativePath" }, "minimumPassed": { "type": "integer", "minimum": 1 } }
    },
    "baseline": {
      "type": "object", "additionalProperties": false, "required": ["identity", "reviewedBy", "reviewedOn", "records"],
      "properties": {
        "identity": { "anyOf": [{ "const": "none" }, { "$ref": "#/$defs/sha64" }] },
        "reviewedBy": { "type": "string" }, "reviewedOn": { "type": "string" },
        "records": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/baselineRecord" } }
      }
    },
    "baselineRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ruleId", "fingerprint", "relativePath", "symbol", "owner", "rationale", "disposition", "createdOn", "expiresOn", "policyVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "ruleId": { "type": "string", "minLength": 1 }, "fingerprint": { "$ref": "#/$defs/sha64" },
        "relativePath": { "$ref": "#/$defs/relativePath" }, "symbol": { "type": "string", "minLength": 1 }, "owner": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }, "disposition": { "enum": ["accepted", "resolved"] }, "createdOn": { "$ref": "#/$defs/date" },
        "expiresOn": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/date" }] }, "policyVersion": { "const": "fsassay-policy/1.1.0" }
      }
    },
    "exception": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "relativePath", "symbol", "owner", "reason", "createdOn", "expiresOn", "shapeClauses"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "enum": ["hosting", "serialization", "persistence", "ui", "dependency-injection", "interoperability"] },
        "relativePath": { "$ref": "#/$defs/relativePath" }, "symbol": { "type": "string", "minLength": 1 }, "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }, "createdOn": { "$ref": "#/$defs/date" },
        "expiresOn": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/date" }] },
        "shapeClauses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(SN|SC)-[A-Z0-9]+$" } }
      }
    }
  }
}
