{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonflow-assay.github.io/FSharpAssay/contracts/fsassay-policy-1.0.0.schema.json",
  "title": "FsAssay authority policy lock 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policySchemaVersion",
    "evidenceSchemaVersion",
    "authorityContractVersion",
    "shapeContractVersion",
    "toolVersion",
    "enabledProfiles",
    "approvedBlockingRules",
    "advisoryRules",
    "experimentalRules",
    "requiredProjectClasses",
    "requiredTargetFrameworks",
    "requiredTests",
    "baseline",
    "exceptions"
  ],
  "properties": {
    "policySchemaVersion": { "const": "fsassay-policy/1.0.0" },
    "evidenceSchemaVersion": { "const": "fsassay-authority-receipt/1.0.0" },
    "authorityContractVersion": { "const": "authority-contract/1.0.0" },
    "shapeContractVersion": { "const": "not-established" },
    "toolVersion": { "const": "1.0.4" },
    "enabledProfiles": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "approvedBlockingRules": { "$ref": "#/$defs/uniqueStrings", "maxItems": 0 },
    "advisoryRules": { "$ref": "#/$defs/uniqueStrings", "maxItems": 0 },
    "experimentalRules": { "$ref": "#/$defs/uniqueStrings" },
    "requiredProjectClasses": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "requiredTargetFrameworks": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "requiredTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "project", "minimumPassed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "project": { "type": "string", "minLength": 1 },
          "minimumPassed": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "approvedFindings"],
      "properties": {
        "identity": { "const": "none" },
        "approvedFindings": { "type": "array", "maxItems": 0 }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "reason", "expiresOn"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "expiresOn": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
