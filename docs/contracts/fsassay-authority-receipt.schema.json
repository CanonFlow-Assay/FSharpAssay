{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonflow-assay.github.io/FSharpAssay/contracts/fsassay-authority-receipt-1.1.0.schema.json",
  "title": "FsAssay authority receipt 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool", "toolVersion", "candidate", "policy", "toolchain", "outcome", "authoritative", "reasons", "counts", "projects", "sources", "tests", "rules", "findings", "appliedBaselineRecords", "appliedSuppressions", "policyErrors", "evidenceErrors", "missingEvidence", "toolFailures"],
  "properties": {
    "schemaVersion": { "const": "fsassay-authority-receipt/1.1.0" },
    "tool": { "const": "FsAssay" }, "toolVersion": { "type": "string", "minLength": 1 },
    "candidate": { "$ref": "#/$defs/candidate" }, "policy": { "$ref": "#/$defs/policyIdentity" }, "toolchain": { "$ref": "#/$defs/toolchain" },
    "outcome": { "enum": ["Pass", "Fail", "Inconclusive", "ToolFailure"] }, "authoritative": { "type": "boolean" },
    "reasons": { "type": "array", "items": { "$ref": "#/$defs/reason" } }, "counts": { "$ref": "#/$defs/counts" },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } }, "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } }, "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }, "appliedBaselineRecords": { "$ref": "#/$defs/strings" },
    "appliedSuppressions": { "type": "array", "maxItems": 0 }, "policyErrors": { "$ref": "#/$defs/strings" }, "evidenceErrors": { "$ref": "#/$defs/strings" },
    "missingEvidence": { "$ref": "#/$defs/strings" }, "toolFailures": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 }, "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!\\.\\./).+" },
    "sha40": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }, "sha64": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "commitSha", "approvedHeadSha", "treeSha", "dirty", "syntheticMergeSha", "packageSha256", "repositoryRelativeTarget"],
      "properties": {
        "kind": { "enum": ["commit", "dirty-worktree", "synthetic-merge", "package", "unversioned"] },
        "commitSha": { "anyOf": [{ "$ref": "#/$defs/sha40" }, { "const": "unavailable" }] }, "approvedHeadSha": { "anyOf": [{ "$ref": "#/$defs/sha40" }, { "const": "unavailable" }] },
        "treeSha": { "anyOf": [{ "$ref": "#/$defs/sha40" }, { "const": "unavailable" }] }, "dirty": { "type": "boolean" },
        "syntheticMergeSha": { "anyOf": [{ "$ref": "#/$defs/sha40" }, { "const": "not-applicable" }] },
        "packageSha256": { "anyOf": [{ "$ref": "#/$defs/sha64" }, { "const": "not-applicable" }] }, "repositoryRelativeTarget": { "$ref": "#/$defs/relativePath" }
      }
    },
    "policyIdentity": {
      "type": "object", "additionalProperties": false, "required": ["status", "path", "sha256", "snapshot", "error"],
      "properties": { "status": { "enum": ["loaded", "invalid", "unavailable"] }, "path": { "$ref": "#/$defs/relativePath" }, "sha256": { "anyOf": [{ "$ref": "#/$defs/sha64" }, { "enum": ["invalid", "unavailable"] }] }, "snapshot": { "$ref": "#/$defs/policySnapshot" }, "error": { "type": "string" } }
    },
    "policySnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["policySchemaVersion", "evidenceSchemaVersion", "authorityContractVersion", "shapeContractVersion", "toolVersion", "evaluationDate", "enabledProfiles", "approvedBlockingRules", "advisoryRules", "experimentalRules", "prototypeRules", "dummyRules", "deprecatedRules", "removedRules", "requiredProjectClasses", "requiredTargetFrameworks", "requiredTests", "baseline", "exceptions"],
      "properties": {
        "policySchemaVersion": { "const": "fsassay-policy/1.1.0" }, "evidenceSchemaVersion": { "const": "fsassay-authority-receipt/1.1.0" }, "authorityContractVersion": { "const": "authority-contract/1.0.0" }, "shapeContractVersion": { "const": "fsharp-shape/1.0.0" },
        "toolVersion": { "type": "string", "minLength": 1 }, "evaluationDate": { "type": "string", "format": "date" }, "enabledProfiles": { "$ref": "#/$defs/strings" },
        "approvedBlockingRules": { "$ref": "#/$defs/strings" }, "advisoryRules": { "$ref": "#/$defs/strings" }, "experimentalRules": { "$ref": "#/$defs/strings" },
        "prototypeRules": { "$ref": "#/$defs/strings" }, "dummyRules": { "$ref": "#/$defs/strings" }, "deprecatedRules": { "$ref": "#/$defs/strings" }, "removedRules": { "$ref": "#/$defs/strings" },
        "requiredProjectClasses": { "$ref": "#/$defs/strings" }, "requiredTargetFrameworks": { "$ref": "#/$defs/strings" }, "requiredTests": { "type": "array", "items": { "$ref": "#/$defs/requiredTestPolicy" } },
        "baseline": { "$ref": "#/$defs/baselinePolicy" }, "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exception" } }
      }
    },
    "baselinePolicy": {
      "type": "object", "additionalProperties": false, "required": ["identity", "reviewedBy", "reviewedOn", "records"],
      "properties": { "identity": { "type": "string", "minLength": 1 }, "reviewedBy": { "type": "string" }, "reviewedOn": { "type": "string" }, "records": { "type": "array", "items": { "$ref": "#/$defs/baselineRecord" } } }
    },
    "baselineRecord": {
      "type": "object", "additionalProperties": false, "required": ["id", "ruleId", "fingerprint", "relativePath", "symbol", "owner", "rationale", "disposition", "createdOn", "expiresOn", "policyVersion"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "ruleId": { "type": "string", "minLength": 1 }, "fingerprint": { "$ref": "#/$defs/sha64" }, "relativePath": { "$ref": "#/$defs/relativePath" }, "symbol": { "type": "string", "minLength": 1 }, "owner": { "type": "string", "minLength": 1 }, "rationale": { "type": "string", "minLength": 1 }, "disposition": { "enum": ["accepted", "resolved"] }, "createdOn": { "type": "string", "format": "date" }, "expiresOn": { "type": "string" }, "policyVersion": { "const": "fsassay-policy/1.1.0" } }
    },
    "requiredTestPolicy": { "type": "object", "additionalProperties": false, "required": ["id", "project", "minimumPassed"], "properties": { "id": { "type": "string", "minLength": 1 }, "project": { "$ref": "#/$defs/relativePath" }, "minimumPassed": { "type": "integer", "minimum": 1 } } },
    "toolchain": { "type": "object", "additionalProperties": false, "required": ["sdkVersion", "runtimeVersion", "fsharpCompilerServiceVersion"], "properties": { "sdkVersion": { "type": "string", "minLength": 1 }, "runtimeVersion": { "type": "string", "minLength": 1 }, "fsharpCompilerServiceVersion": { "type": "string", "minLength": 1 } } },
    "reason": { "type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": { "code": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 } } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["projectsDiscovered", "projectsLoaded", "projectsWorkspaceLoaded", "projectsSupported", "projectsFailed", "projectsSkipped", "projectsUnsupported", "eligibleFiles", "analyzedFiles", "compilerIncompleteFiles"], "properties": { "projectsDiscovered": { "$ref": "#/$defs/count" }, "projectsLoaded": { "$ref": "#/$defs/count" }, "projectsWorkspaceLoaded": { "$ref": "#/$defs/count" }, "projectsSupported": { "$ref": "#/$defs/count" }, "projectsFailed": { "$ref": "#/$defs/count" }, "projectsSkipped": { "$ref": "#/$defs/count" }, "projectsUnsupported": { "$ref": "#/$defs/count" }, "eligibleFiles": { "$ref": "#/$defs/count" }, "analyzedFiles": { "$ref": "#/$defs/count" }, "compilerIncompleteFiles": { "$ref": "#/$defs/count" } } },
    "project": { "type": "object", "additionalProperties": false, "required": ["path", "projectClass", "targetFrameworks", "supported", "loaded", "status", "reason"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "projectClass": { "type": "string", "minLength": 1 }, "targetFrameworks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "supported": { "type": "boolean" }, "loaded": { "type": "boolean" }, "status": { "enum": ["loaded", "failed", "skipped", "unsupported"] }, "reason": { "type": "string" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["path", "disposition", "reason"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "disposition": { "enum": ["analyzed", "compiler-incomplete", "generated-excluded", "policy-excluded"] }, "reason": { "type": "string" } } },
    "test": { "type": "object", "additionalProperties": false, "required": ["id", "project", "status", "passed", "failed", "skipped"], "properties": { "id": { "type": "string", "minLength": 1 }, "project": { "$ref": "#/$defs/relativePath" }, "status": { "enum": ["passed", "failed", "notRun", "skipped"] }, "passed": { "$ref": "#/$defs/count" }, "failed": { "$ref": "#/$defs/count" }, "skipped": { "$ref": "#/$defs/count" } } },
    "rule": { "type": "object", "additionalProperties": false, "required": ["ruleId", "authorityClass", "status", "evidenceAvailable", "findingCount"], "properties": { "ruleId": { "type": "string", "minLength": 1 }, "authorityClass": { "$ref": "#/$defs/authorityClass" }, "status": { "enum": ["completed", "incomplete", "unavailable"] }, "evidenceAvailable": { "type": "boolean" }, "findingCount": { "$ref": "#/$defs/count" } } },
    "finding": { "type": "object", "additionalProperties": false, "required": ["ruleId", "path", "symbol", "line", "column", "message", "fingerprint", "authorityClass"], "properties": { "ruleId": { "type": "string", "minLength": 1 }, "path": { "$ref": "#/$defs/relativePath" }, "symbol": { "type": "string", "minLength": 1 }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 0 }, "message": { "type": "string", "minLength": 1 }, "fingerprint": { "$ref": "#/$defs/sha64" }, "authorityClass": { "$ref": "#/$defs/authorityClass" } } },
    "authorityClass": { "enum": ["blocking", "advisory", "experimental", "prototype", "dummy", "deprecated", "removed", "unclassified"] },
    "exception": { "type": "object", "additionalProperties": false, "required": ["id", "category", "relativePath", "symbol", "owner", "reason", "createdOn", "expiresOn", "shapeClauses"], "properties": { "id": { "type": "string", "minLength": 1 }, "category": { "enum": ["hosting", "serialization", "persistence", "ui", "dependency-injection", "interoperability"] }, "relativePath": { "$ref": "#/$defs/relativePath" }, "symbol": { "type": "string", "minLength": 1 }, "owner": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "createdOn": { "type": "string", "format": "date" }, "expiresOn": { "type": "string" }, "shapeClauses": { "$ref": "#/$defs/strings" } } }
  }
}
